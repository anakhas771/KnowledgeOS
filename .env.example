# KnowledgeOS environment variables — copy to backend/.env and fill in secrets

# Django
SECRET_KEY=change-me-in-production

DEBUG=True

# PostgreSQL
POSTGRES_DB=knowledgeos
POSTGRES_USER=knowledgeos_user
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Embedding service (running as a separate process / Docker service)
EMBEDDING_SERVICE_URL=http://embedding-service:8100

# Ollama (local LLM — runs on the host, reached via host.docker.internal inside Docker)
# Do NOT expose Ollama's port through the compose file.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
